{
  "scripts": {
    "run-cyruscyliu-github-io": {
      "type": "service",
      "command": "sh -lc 'mkdocs serve --livereload --dev-addr \"0.0.0.0:${RUN_CYRUSCYLIU_GITHUB_IO_PORT:-8000}\"'"
    },
    "run-cyruscyliu-github-io-b": {
      "type": "service",
      "command": "sh -lc 'cd third_party/cyruscyliu.github.io/b && node_modules/.bin/astro dev --host 0.0.0.0 --port \"${RUN_CYRUSCYLIU_GITHUB_IO_B_PORT:-4400}\"'"
    }
  }
}
