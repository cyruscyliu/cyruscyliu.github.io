{
  "name": "cyruscyliu-home",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "prebuild": "npm test",
    "dev": "npm run build && astro dev",
    "build": "node scripts/convert-dblp.mjs && node scripts/generate-course-graphs.mjs && node scripts/generate-sitemap.mjs && (node scripts/fetch-tools.mjs || true) && astro build && npm run validate:sitemap",
    "validate:sitemap": "node scripts/validate-sitemap.mjs && node scripts/validate-course-indexing.mjs",
    "preview": "astro preview",
    "fetch-dblp": "node scripts/fetch-dblp.mjs",
    "convert-dblp": "node scripts/convert-dblp.mjs"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "cytoscape": "3.31.0",
    "cytoscape-dagre": "2.5.0",
    "dagre": "0.8.5",
    "lucide-static": "^1.46.0",
    "mermaid": "^11.17.2",
    "sax": "^1.6.1",
    "three": "^0.186.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  }
}
