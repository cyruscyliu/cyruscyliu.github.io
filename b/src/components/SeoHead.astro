---
interface Props {
  lang: 'en' | 'zh';
  path?: string;
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  alternates?: boolean;
}

const {
  lang,
  path = '',
  title,
  description,
  type = 'website',
  image = '/logo-lockup.png',
  alternates = true
} = Astro.props;
const site = Astro.site ?? new URL('https://cyruscyliu.github.io');
const normalizedPath = path ? `${path.replace(/^\/+|\/+$/g, '')}/` : '';
const localizedUrl = (language: 'en' | 'zh') => new URL(`/${language}/${normalizedPath}`, site).href;
const canonical = localizedUrl(lang);
const imageUrl = new URL(image, site).href;
const imageAlt = lang === 'zh' ? '55AA 安全实验室标志' : '55AA Security Lab logo';
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="author" content="55AA Security Lab" />
<link rel="preload" as="image" href="/logo-lockup.svg" type="image/svg+xml" />
<link rel="canonical" href={canonical} />
{alternates && <link rel="alternate" hreflang="en" href={localizedUrl('en')} />}
{alternates && <link rel="alternate" hreflang="zh" href={localizedUrl('zh')} />}
{alternates && <link rel="alternate" hreflang="x-default" href={localizedUrl('en')} />}
<link rel="icon" href="/logo.png" type="image/png" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="55AA Security Lab" />
<meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
{alternates && <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
