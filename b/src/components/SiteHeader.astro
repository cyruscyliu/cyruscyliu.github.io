---
import homeData from '../data/home.json';
const { lang: propLang = 'en', blogHref = null } = Astro.props;
const lang = Astro.params?.lang === 'zh' ? 'zh' : (Astro.params?.lang === 'en' ? 'en' : propLang);
const home = `/${lang}/`;
const language = lang === 'en' ? '中文' : 'English';
const languageHref = blogHref ? `/${lang === 'en' ? 'zh' : 'en'}/${blogHref}` : `/${lang === 'en' ? 'zh' : 'en'}/`;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="site-header">
  <div class="brand-lockup">
    <!-- GBU logo temporarily hidden pending written brand authorization.
    <a class="gbu-logo" href="https://www.gbu.edu.cn/" aria-label="Great Bay University"><img src="/gbu-logo.png" width="132" height="32" loading="eager" decoding="sync" alt="Great Bay University" /></a>
    -->
    <a class="site-name" href={home}><img src="/logo.svg" width="40" height="40" loading="eager" decoding="sync" alt="" /><h1 class="wordmark"><span>55AA</span><span>Security Lab</span></h1></a>
  </div>
  <a class="language" href={languageHref}>{language}</a>
</header>
<nav class="tabs" aria-label="Sections">{homeData.sections.map((tab) => { const href = `/${lang}/${tab.key === 'home' ? '' : `${tab.key}/`}`; const active = currentPath === href.replace(/\/+$/, '') || (tab.key === 'blog' && currentPath.startsWith(`/${lang}/blog`)); return <a class={active ? 'active' : undefined} href={href} aria-current={active ? 'page' : undefined}>{tab.label[lang]}</a> })}</nav>
<style>
  .site-header,.tabs { width:min(960px,calc(100% - 2rem)); margin-inline:auto; }.site-header { display:flex; justify-content:space-between; align-items:center; padding:1.25rem 0; }.brand-lockup,.site-name { display:flex; align-items:center; }.brand-lockup{gap:1rem}.site-name{gap:.55rem;color:#000;text-decoration:none}.gbu-logo img{display:block;height:2rem;width:auto}.site-name>img{display:block;width:2rem;height:2rem}h1.wordmark{display:flex;flex-direction:column;gap:0;line-height:1;margin:0!important;padding:0;font:inherit;font-size:1rem;font-weight:400}h1.wordmark span:first-child{font-size:1rem;font-weight:600}h1.wordmark span:last-child{font-size:.8rem;line-height:1}.language,.tabs a,.tab{color:#06c}.tabs{display:flex!important;justify-content:flex-start!important;align-items:center;flex-wrap:wrap;gap:.25rem 1.1rem;padding:.35rem 0}.tabs a,.tab{display:inline-block;text-decoration:none;padding:.25rem 0;margin:0;font:inherit}.tab{border:0;background:none;cursor:pointer}.tabs a.active{color:#000;font-weight:600}
</style>
