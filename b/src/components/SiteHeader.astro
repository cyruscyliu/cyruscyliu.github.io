---
import homeData from '../data/home.json';
import languagesIcon from 'lucide-static/icons/languages.svg?url';
const { lang: propLang = 'en', blogHref = null } = Astro.props;
const lang = Astro.params?.lang === 'zh' ? 'zh' : (Astro.params?.lang === 'en' ? 'en' : propLang);
const home = `/${lang}/`;
const language = lang === 'en' ? '中文' : 'English';
const languageHref = blogHref ? `/${lang === 'en' ? 'zh' : 'en'}/${blogHref}` : `/${lang === 'en' ? 'zh' : 'en'}/`;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="site-header">
  <div class="brand-lockup">
    <!-- GBU logo temporarily hidden pending written brand authorization.
    <a class="gbu-logo" href="https://www.gbu.edu.cn/" aria-label="Great Bay University"><img src="/gbu-logo.png" width="132" height="32" loading="eager" decoding="sync" alt="Great Bay University" /></a>
    -->
    <a class="site-name" href={home}><img src="/logo-lockup.svg" width="125" height="40" loading="eager" decoding="sync" alt="55AA Security Lab" /></a>
  </div>
  <a class="language" href={languageHref} aria-label={language} title={language} style="display:inline-flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;text-decoration:none;">
    <img src={languagesIcon} width="22" height="22" alt="" loading="eager" decoding="sync" aria-hidden="true" style="display:block;width:1.375rem;height:1.375rem;" />
  </a>
</header>
<nav class="tabs" aria-label="Sections">{homeData.sections.map((tab) => { const href = `/${lang}/${tab.key === 'home' ? '' : `${tab.key}/`}`; const active = currentPath === href.replace(/\/+$/, '') || (tab.key === 'blog' && currentPath.startsWith(`/${lang}/blog`)); return <a class={active ? 'active' : undefined} href={href} aria-current={active ? 'page' : undefined}>{tab.label[lang]}</a> })}</nav>
<style>
  .site-header,.tabs { width:min(960px,calc(100% - 2rem)); margin-inline:auto; }.site-header { display:flex; justify-content:space-between; align-items:center; padding:1.25rem 0; }.brand-lockup,.site-name { display:flex; align-items:center; }.brand-lockup{gap:1rem}.site-name{color:#000;text-decoration:none}.gbu-logo img{display:block;height:2rem;width:auto}.site-name>img{display:block;width:7.8125rem;height:2.5rem}.language,.tabs a,.tab{color:#06c}.tabs{display:flex!important;justify-content:flex-start!important;align-items:center;flex-wrap:wrap;gap:.25rem 1.1rem;padding:.35rem 0}.tabs a,.tab{display:inline-block;text-decoration:none;padding:.25rem 0;margin:0;font:inherit}.tab{border:0;background:none;cursor:pointer}.tabs a.active{color:#000;font-weight:600}
</style>
