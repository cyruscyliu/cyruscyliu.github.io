---
import data from '../data/courses.json';

const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const allCourses = data.courses.map(c => ({
  code: c.code,
  name: zh ? c.name.zh : c.name.en,
  level: c.level.en,
  status: zh ? c.status.zh : c.status.en,
  url: `/${lang}/courses/${c.code.toLowerCase()}/`
}));

const graphData = JSON.stringify({
  courses: allCourses,
  dependencies: data.dependencies
});

const gradCourses = allCourses.filter(c => c.level === 'Graduate');
---

<div class="course-graphs">
  <figure class="course-graph">
    <figcaption>{zh ? '本科生课程图' : 'Undergraduate Course Graph'}</figcaption>
    <div id="cy-undergraduate" class="cy-container" data-level="Undergraduate" data-graph={graphData}></div>
  </figure>
  <figure class="course-graph">
    <figcaption>{zh ? '研究生课程' : 'Graduate Courses'}</figcaption>
    <div class="grad-grid">
      {gradCourses.map(c => (
        <a href={c.url} class:list={['grad-card', { placeholder: c.status === 'Placeholder' || c.status === '待定' }]}>
          <span class="grad-code" style={`font-size:${zh ? '14px' : '13px'}`}>{c.code}</span>
          <span class="grad-name" style={`font-size:${zh ? '14px' : '13px'}`}>{c.name}</span>
        </a>
      ))}
    </div>
  </figure>
</div>

<script>
import cytoscape from 'cytoscape';
import dagre from 'cytoscape-dagre';
cytoscape.use(dagre);

const UG = { bg: '#d9ebfb', border: '#8bb8df' };

function wrapLabel(text, maxLen) {
  if (text.length <= maxLen) return text;
  const words = text.split(/\s+/);
  const lines = [];
  let line = '';
  for (const w of words) {
    const candidate = line ? line + ' ' + w : w;
    if (candidate.length > maxLen) {
      if (line) lines.push(line);
      line = w;
    } else {
      line = candidate;
    }
  }
  if (line) lines.push(line);
  return lines.join('\n');
}

function initGraph(container) {
  const graphData = JSON.parse(container.dataset.graph);
  const levelFilter = container.dataset.level;
  const codes = new Set(graphData.courses.filter(c => c.level === levelFilter).map(c => c.code));
  const isCJK = /[一-鿿]/.test(graphData.courses[0]?.name ?? '');
  const wrapLen = isCJK ? 6 : 14;

  const nodes = graphData.courses
    .filter(c => c.level === levelFilter)
    .map(c => ({
      data: {
        id: c.code,
        label: wrapLabel(c.name, wrapLen),
        code: c.code,
        url: c.url,
        placeholder: c.status === 'Placeholder' || c.status === '待定'
      }
    }));

  const edges = graphData.dependencies
    .filter(([s, t]) => codes.has(s) && codes.has(t))
    .map(([s, t]) => ({ data: { id: `${s}-${t}`, source: s, target: t } }));

  // Use 2x pixel ratio for crisp text
  const dpr = Math.max(window.devicePixelRatio || 1, 2);

  const nodeW = 160;
  const nodeH = 80;
  const fontSize = isCJK ? 14 : 13;

  const cy = cytoscape({
    container,
    elements: [...nodes, ...edges],
    pixelRatio: dpr,
    style: [
      {
        selector: 'node',
        style: {
          shape: 'roundrectangle',
          width: nodeW,
          height: nodeH,
          'background-color': ele => ele.data('placeholder') ? '#f5f5f5' : UG.bg,
          'border-width': 1.5,
          'border-color': ele => ele.data('placeholder') ? '#ddd' : UG.border,
          label: ele => ele.data('code') + '\n' + ele.data('label'),
          'text-wrap': 'wrap',
          'text-valign': 'center',
          'text-halign': 'center',
          'font-size': fontSize,
          'line-height': 1.4,
          'font-family': isCJK
            ? '"Noto Sans CJK SC","PingFang SC","Microsoft YaHei",sans-serif'
            : '"Inter","Segoe UI",system-ui,sans-serif',
          color: ele => ele.data('placeholder') ? '#999' : '#111',
          cursor: 'pointer',
          'transition-property': 'background-color, border-color, border-width, opacity',
          'transition-duration': '120ms'
        }
      },
      {
        selector: 'node.hl',
        style: { 'border-color': '#0066cc', 'border-width': 2.5, 'background-color': '#dceeff' }
      },
      {
        selector: 'node.dim',
        style: { opacity: 0.2 }
      },
      {
        selector: 'edge',
        style: {
          width: 1.2,
          'line-color': '#b0c8de',
          'target-arrow-color': '#b0c8de',
          'target-arrow-shape': 'triangle',
          'arrow-scale': 0.75,
          'curve-style': 'bezier',
          'transition-property': 'line-color, target-arrow-color, width, opacity',
          'transition-duration': '120ms'
        }
      },
      {
        selector: 'edge.hl',
        style: { 'line-color': '#0066cc', 'target-arrow-color': '#0066cc', width: 2 }
      },
      {
        selector: 'edge.dim',
        style: { opacity: 0.08 }
      }
    ],
    layout: {
      name: 'dagre',
      rankDir: 'TB',
      nodeSep: 8,
      rankSep: 8,
      padding: 12,
      animate: false
    },
    userZoomingEnabled: false,
    userPanningEnabled: false,
    boxSelectionEnabled: false,
    autoungrabify: true
  });

  cy.on('mouseover', 'node', evt => {
    const n = evt.target;
    const neighborhood = n.closedNeighborhood();
    cy.elements().not(neighborhood).addClass('dim');
    neighborhood.nodes().addClass('hl');
    neighborhood.edges().addClass('hl');
  });

  cy.on('mouseout', 'node', () => {
    cy.elements().removeClass('dim hl');
  });

  cy.on('tap', 'node', evt => {
    const url = evt.target.data('url');
    if (url) window.location.href = url;
  });

  // No zoom — render at 1:1, set height to fit all nodes, width is 100% via CSS
  const pad = 24;
  const bb = cy.elements().boundingBox();
  const h = Math.ceil(bb.h + pad * 2);
  container.style.height = h + 'px';
  cy.resize();
  cy.viewport({ zoom: 1, pan: { x: pad - bb.x1, y: pad - bb.y1 } });
}

document.querySelectorAll('.cy-container').forEach(initGraph);
</script>

<style>
  .course-graphs { display: grid; gap: 2rem; margin: 0 0 2rem; }
  .course-graph { margin: 0; }
  figcaption { margin-bottom: .75rem; font-weight: 600; font-size: .95rem; }
  .cy-container { width: 100%; min-height: 280px; background: transparent; }

  .grad-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 8px;
  }
  .grad-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .25rem;
    height: 80px;
    padding: .5rem .75rem;
    border-radius: 6px;
    border: 1.5px solid #c0a0e0;
    background: #eadcf8;
    text-decoration: none;
    color: #111;
    text-align: center;
    transition: background 120ms, border-color 120ms;
  }
  .grad-card:hover { background: #ddc8f5; border-color: #9060c0; }
  .grad-card.placeholder { background: #f5f5f5; border-color: #ddd; color: #999; }
  .grad-code { font-weight: 600; color: #6c348f; }
  .grad-card.placeholder .grad-code { color: #bbb; }
  .grad-name { line-height: 1.35; }
</style>
