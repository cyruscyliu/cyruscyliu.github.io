  C019 --> C004
  C019 --> C012
  C004 --> C020["${label('55AA-020', 'Trusted Computing Methods & Security', '可信计算方法和安全')}"]
  C008 --> C020
  C007 --> C020
  C019 --> C020
  C010 --> C020
  C003 --> C020
  C008 --> C021["${label('55AA-021', 'Embedded Systems Principles & Security', '嵌入式系统原理和安全')}"]
  C007 --> C021
  C013 --> C021
  C003 --> C021
