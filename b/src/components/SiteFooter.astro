---
const { lang } = Astro.props;
---
<footer class="footer-upper"><div class="footer-identity"><div class="footer-logos">
<!-- GBU logo temporarily hidden pending written brand authorization.
<a href="https://www.gbu.edu.cn/" aria-label="Great Bay University"><img src="/gbu-logo.png" width="132" height="32" loading="eager" decoding="sync" alt="Great Bay University" /></a>
-->
<div class="footer-site-mark"><img src="/logo-lockup.svg" width="125" height="40" loading="eager" decoding="sync" alt="55AA Security Lab" /></div></div>
<!-- Campus address temporarily hidden pending confirmation of institutional presentation. -->
</div><div class="footer-social"><div class="qr-code"><img src="/qrcode_for_gh_c0a9f07214bf_258.jpg" width="88" height="88" loading="eager" decoding="async" alt={lang === 'zh' ? '55AA Security Lab 微信公众号二维码' : '55AA Security Lab WeChat Official Account QR code'} /><span>{lang === 'zh' ? '公众号' : 'WeChat Official Account'}</span></div></div></footer><footer class="footer-lower"><span>{lang === 'zh' ? '© 2026 55AA Security Lab。版权所有。' : '© 2026 55AA Security Lab. All rights reserved.'}</span><span>{lang === 'zh' ? '最后编辑：2026-09-19' : 'Last edited: 2026-09-19'}</span></footer>
<style>
  footer{width:min(960px,calc(100% - 2rem));margin-inline:auto;box-sizing:border-box}.footer-upper{min-height:149.656px;box-sizing:border-box;display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;padding:2rem 0 1.25rem;border-top:1px solid #eee;color:#555;font-size:.9rem}.footer-logos,.footer-site-mark{display:flex;align-items:center}.footer-logos{gap:1rem}.footer-logos > a img{display:block;height:2rem;width:auto;object-fit:contain}.footer-site-mark{color:#000}.footer-site-mark img{display:block;width:7.8125rem;height:2.5rem}.footer-identity p{margin:.75rem 0 0}.footer-social{display:flex;gap:.75rem}.qr-code{display:flex;flex-direction:column;align-items:center;gap:.35rem;color:#555;text-align:center}.qr-code img{display:block;width:5.5rem;height:5.5rem;object-fit:cover}.qr-code span{max-width:7.5rem;font-size:.75rem;line-height:1.25}.footer-lower{min-height:70.328px;box-sizing:border-box;display:flex;justify-content:space-between;gap:1rem;padding:1rem 0 2rem;color:#555;font-size:.9rem}@media(max-width:600px){.footer-upper,.footer-lower{flex-wrap:wrap}}
</style>
