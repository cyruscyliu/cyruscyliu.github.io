---
const { lang } = Astro.props;
---
<footer class="footer-upper"><div class="footer-identity"><div class="footer-logos">
<!-- GBU logo temporarily hidden pending written brand authorization.
<a href="https://www.gbu.edu.cn/" aria-label="Great Bay University"><img src="/gbu-logo.png" width="132" height="32" loading="eager" decoding="sync" alt="Great Bay University" /></a>
-->
<div class="footer-site-mark"><img src="/logo.svg" width="40" height="40" loading="eager" decoding="sync" alt="" /><span><strong>55AA</strong><span>Security Lab</span></span></div></div>
<!-- Campus address temporarily hidden pending confirmation of institutional presentation. -->
</div><div class="footer-social"><div class="qr-placeholder"><span>{lang === 'zh' ? '交流群' : 'Community'}</span><small>QR placeholder</small></div><div class="qr-placeholder"><span>Bilibili</span><small>QR placeholder</small></div><div class="qr-placeholder"><span>小红书</span><small>QR placeholder</small></div><div class="qr-placeholder"><span>infosec.exchange</span><small>QR placeholder</small></div></div></footer><footer class="footer-lower"><span>© 2026 55AA Security Lab. All rights reserved.</span><span>{lang === 'zh' ? '最后编辑：2026-09-15' : 'Last edited: 2026-09-15'}</span></footer>
<style>
  footer{width:min(960px,calc(100% - 2rem));margin-inline:auto;box-sizing:border-box}.footer-upper{min-height:149.656px;box-sizing:border-box;display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;padding:2rem 0 1.25rem;border-top:1px solid #eee;color:#555;font-size:.9rem}.footer-logos,.footer-site-mark{display:flex;align-items:center}.footer-logos{gap:1rem}.footer-logos > a img{display:block;height:2rem;width:auto;object-fit:contain}.footer-logos > .footer-site-mark > img{width:2rem;height:2rem}.footer-site-mark{gap:.55rem;color:#000}.footer-site-mark img{width:2rem;height:2rem}.footer-site-mark>span{display:flex;flex-direction:column;line-height:1;gap:0}.footer-site-mark strong{font-size:1rem}.footer-site-mark>span>span{font-size:.8rem}.footer-identity p{margin:.75rem 0 0}.footer-social{display:flex;gap:.75rem}.qr-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;width:5.5rem;height:5.5rem;border:1px dashed #aaa;color:#777;text-align:center}.qr-placeholder small{font-size:.65rem}.footer-lower{min-height:70.328px;box-sizing:border-box;display:flex;justify-content:space-between;gap:1rem;padding:1rem 0 2rem;color:#555;font-size:.9rem}@media(max-width:600px){.footer-upper,.footer-lower{flex-wrap:wrap}}
</style>
