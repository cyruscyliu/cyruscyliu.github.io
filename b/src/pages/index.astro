<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/en/" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      const language = navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en';
      window.location.replace(`/${language}/`);
    </script>
  </head>
  <body></body>
</html>
