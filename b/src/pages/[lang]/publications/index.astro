---
import config from '../../../data/publications.json';
import dblp from '../../../data/dblp.json';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SeoHead from '../../../components/SeoHead.astro';
import PublicationList from '../../../components/PublicationList.astro';

export function getStaticPaths() {
  return ['en', 'zh'].map((lang) => ({ params: { lang }, props: { lang } }));
}

const lang = Astro.props.lang === 'zh' ? 'zh' : 'en';
---
<!doctype html>
<html lang={lang}>
<head>
<SeoHead lang={lang} path="publications" title={`${config.meta.title[lang]} · 55AA Security Lab`} description={config.meta.description[lang]}/>
</head>
<body>
<SiteHeader lang={lang} blogHref="publications/"/>
<main>
<h1 class="visually-hidden">{config.meta.title[lang]}</h1>
<PublicationList lang={lang} publications={dblp.publications} showFilters={true}/>
</main>
<SiteFooter lang={lang}/>
</body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { overflow-y: scroll; }
  :global(body) { min-height: 100vh; display: flex; flex-direction: column; margin: 0; background: #fff; color: #000; font: 16px/1.55 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(main) { flex: 1; width: min(960px, calc(100% - 2rem)); margin: 0 auto; padding: 1.5rem 0 2rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  a { color: #06c; }
</style>
