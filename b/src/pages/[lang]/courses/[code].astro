---
import data from '../../../data/courses.json';
import refs from '../../../data/course-references.json';
import syllabi from '../../../data/syllabi.js';
import lessonPlans from '../../../data/lesson-plans/index.js';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SeoHead from '../../../components/SeoHead.astro';

const slug = (code) => code.toLowerCase();

export function getStaticPaths() {
  const languages = ['en', 'zh'];
  return languages.flatMap((lang) => data.courses.map((course) => ({
    params: { lang, code: course.code.toLowerCase() },
    props: { lang, course }
  })));
}

const { lang, course } = Astro.props;
const text = (value) => typeof value === 'string' ? value : value?.[lang] ?? '';
const title = `${course.code} ${text(course.name)}`;
const syllabus = syllabi[course.code];
const description = text(syllabus?.summary) || `${text(course.level)} · ${text(course.status)}`;
const courseRefs = refs[course.code];
const lessons = lessonPlans[course.code] ?? [];
const lessonsForWeek = (weekNumber) => lessons.filter((lesson) => lesson.week === weekNumber);
const lessonNumber = (lesson) => lessons.findIndex((item) => item.id === lesson.id) + 1;
const sorted = (list) => list ? [...list].sort((a, b) => a.school.localeCompare(b.school)) : [];
const list = (value) => value?.[lang] ?? value?.zh ?? value?.en ?? [];
const isDraftCourse = ['Under development', 'Placeholder'].includes(course.status?.en);
const draftNotice = lang === 'zh'
  ? '提示：本课程仍在持续设计和校准中，页面内容仅供参考，不代表最终教学版本。'
  : 'Note: this course is still being designed and calibrated; the page content is for reference and does not represent the final teaching version.';
---
<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead lang={lang} path={`courses/${slug(course.code)}`} title={`${title} · 55AA Security Lab`} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Course',
      name: title,
      description,
      url: `https://cyruscyliu.github.io/${lang}/courses/${slug(course.code)}/`,
      inLanguage: lang,
      isAccessibleForFree: true,
      provider: { '@type': 'Organization', name: '55AA Security Lab', url: 'https://cyruscyliu.github.io/' }
    })} />
  </head>
  <body>
    <SiteHeader lang={lang} blogHref={`courses/${slug(course.code)}/`} />
    <main>
      <article>
        <p class="meta">{course.code}</p>
        <h1>{text(course.name)}</h1>
        <dl>
          <div>
            <dt>{lang === 'zh' ? '层级' : 'Level'}</dt>
            <dd>{text(course.level)}</dd>
          </div>
          <div>
            <dt>{lang === 'zh' ? '状态' : 'Status'}</dt>
            <dd>{text(course.status)}</dd>
          </div>
        </dl>
        {isDraftCourse && <p class="notice">{draftNotice}</p>}

        {syllabus && (
          <section class="syllabus">
            <h2>{lang === 'zh' ? '教学大纲' : 'Syllabus'}</h2>

            {(syllabus.summary || syllabus.positioning) && (
              <div class="syllabus-block overview">
                <h3>{lang === 'zh' ? '课程概览' : 'Course Overview'}</h3>
                {syllabus.summary && <p class="lead">{text(syllabus.summary)}</p>}
                {syllabus.positioning && <p>{text(syllabus.positioning)}</p>}
              </div>
            )}

            {syllabus.prerequisites && (
              <div class="syllabus-block">
                <h3>{lang === 'zh' ? '先修要求' : 'Prerequisites'}</h3>
                <ul>
                  {list(syllabus.prerequisites).map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )}

            {syllabus.learningOutcomes && (
              <div class="syllabus-block">
                <h3>{lang === 'zh' ? '学习目标' : 'Learning Outcomes'}</h3>
                <ul>
                  {list(syllabus.learningOutcomes).map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )}

            {syllabus.format && (
              <div class="syllabus-block">
                <h3>{lang === 'zh' ? '教学组织' : 'Course Format'}</h3>
                <ul>
                  {list(syllabus.format).map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )}

            {syllabus.weeklyPlan && (
              <div class="syllabus-block">
                <h3>{lang === 'zh' ? '周计划' : 'Weekly Plan'}</h3>
                <div class="weeks">
                  {syllabus.weeklyPlan.map((week) => {
                    const weekLessons = lessonsForWeek(week.week);
                    return (
                      <div class="week">
                        <div class="week-number">{lang === 'zh' ? `第 ${week.week} 周` : `Week ${week.week}`}</div>
                        <div>
                          <h4>{text(week.topic)}</h4>
                          <p>{text(week.work)}</p>
                          {weekLessons.length > 0 && (
                            <div class="week-lessons" aria-label={lang === 'zh' ? '本周教学计划' : 'Teaching plans for this week'}>
                              {weekLessons.map((lesson) => (
                                <a href={`/${lang}/courses/${slug(course.code)}/lessons/${lesson.id}/`}>
                                  <span>{lang === 'zh' ? `第 ${lessonNumber(lesson)} 次课` : `Session ${lessonNumber(lesson)}`}</span>
                                  <strong>{text(lesson.title)}</strong>
                                  <em>{lesson.durationMinutes} min</em>
                                </a>
                              ))}
                            </div>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {syllabus.assessment && (
              <div class="syllabus-block">
                <h3>{lang === 'zh' ? '考核方式' : 'Assessment'}</h3>
                <div class="assessment">
                  {syllabus.assessment.map((item) => (
                    <div class="assessment-row">
                      <div>
                        <strong>{text(item.item)}</strong>
                        <p>{text(item.description)}</p>
                      </div>
                      <span>{item.weight}%</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {syllabus.project && (
              <div class="syllabus-block">
                <h3>{lang === 'zh' ? '课程项目' : 'Course Project'}</h3>
                <p>{text(syllabus.project)}</p>
              </div>
            )}

            {syllabus.policies && (
              <div class="syllabus-block">
                <h3>{lang === 'zh' ? '课程政策' : 'Policies'}</h3>
                <ul>
                  {list(syllabus.policies).map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )}
          </section>
        )}

        {courseRefs && (
          <section class="references">
            <h2>{lang === 'zh' ? '参考课程' : 'Reference Courses'}</h2>

            {courseRefs.international && courseRefs.international.length > 0 && (
              <div class="ref-group">
                <h3>{lang === 'zh' ? '国际名校' : 'International'}</h3>
                <ul>
                  {sorted(courseRefs.international).map((r) => (
                    <li>
                      <span class="school">{r.school}</span>
                      <a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {courseRefs.china985 && courseRefs.china985.length > 0 && (
              <div class="ref-group">
                <h3>{lang === 'zh' ? '中国 985 高校' : 'China 985 Universities'}</h3>
                <ul>
                  {sorted(courseRefs.china985).map((r) => (
                    <li>
                      <span class="school">{r.school}</span>
                      <a href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )}
      </article>
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
<style>
  :global(html) { overflow-y: scroll; }
  :global(*) { box-sizing: border-box; }
  :global(body) { min-height: 100vh; display: flex; flex-direction: column; width: 100%; max-width: none; margin: 0; padding: 0; background: #fff; color: #000; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 16px; line-height: 1.55; }
  :global(main) { flex: 1; width: min(960px, calc(100% - 2rem)); margin-inline: auto; padding: 1.5rem 0 2rem; }
  a { color: #06c; }
  article { margin-top: 0; }
  h1 { max-width: 46rem; margin: .2rem 0 1.25rem; font-size: 1.6rem; line-height: 1.25; font-weight: 600; }
  .meta { margin: 0; color: #777; font-size: .9rem; }
  dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; max-width: 38rem; margin: 0; }
  dl div { padding-top: .8rem; border-top: 1px solid #e5e5e5; }
  dt { color: #777; font-size: .85rem; }
  dd { margin: .15rem 0 0; }
  .notice { max-width: 50rem; margin: 1rem 0 0; color: #555; font-size: .9rem; }
  @media (max-width: 600px) { dl { grid-template-columns: 1fr; } }

  .syllabus { margin-top: 2.5rem; }
  .references { margin-top: 2.5rem; }
  .syllabus h2,
  .references h2 { font-size: 1.1rem; font-weight: 600; margin: 0 0 1.25rem; padding-bottom: .5rem; border-bottom: 1px solid #e5e5e5; }
  .syllabus .lead { max-width: 50rem; font-size: 1rem; }
  .syllabus p { max-width: 50rem; }
  .syllabus-block { margin-top: 1.75rem; }
  .syllabus-block.overview { margin-top: 0; }
  .syllabus-block h3 { font-size: 1rem; font-weight: 600; margin: 0 0 .6rem; }
  .syllabus-block ul { max-width: 50rem; margin: 0; padding-left: 1.2rem; }
  .syllabus-block li + li { margin-top: .25rem; }
  .weeks { display: grid; gap: .65rem; max-width: 56rem; }
  .week { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1rem; padding-top: .7rem; border-top: 1px solid #eee; }
  .week-number { color: #666; font-size: .85rem; }
  .week h4 { margin: 0; font-size: .95rem; font-weight: 600; }
  .week p { margin: .2rem 0 0; color: #333; }
  .week-lessons { display: grid; gap: .35rem; max-width: 48rem; margin-top: .55rem; }
  .week-lessons a { display: grid; grid-template-columns: 4.8rem minmax(0, 1fr) 4rem; gap: .6rem; align-items: baseline; padding: .45rem .55rem; border-left: 2px solid #d8e8ff; background: #f7fbff; text-decoration: none; }
  .week-lessons span { color: #666; font-size: .82rem; }
  .week-lessons strong { color: #06c; font-size: .9rem; font-weight: 600; }
  .week-lessons em { color: #555; font-size: .82rem; font-style: normal; text-align: right; }
  .assessment { max-width: 54rem; border-top: 1px solid #eee; }
  .assessment-row { display: grid; grid-template-columns: minmax(0, 1fr) 4rem; gap: 1rem; padding: .75rem 0; border-bottom: 1px solid #eee; }
  .assessment-row p { margin: .15rem 0 0; color: #333; }
  .assessment-row span { text-align: right; font-weight: 600; }
  @media (max-width: 600px) {
    .week { grid-template-columns: 1fr; gap: .2rem; }
    .week-lessons a { grid-template-columns: 1fr; gap: .1rem; }
    .week-lessons em { text-align: left; }
    .assessment-row { grid-template-columns: 1fr; }
    .assessment-row span { text-align: left; }
  }

  .ref-group { margin-bottom: 1.5rem; }
  .ref-group h3 { font-size: .85rem; font-weight: 600; color: #777; text-transform: uppercase; letter-spacing: .04em; margin: 0 0 .6rem; }
  .ref-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .35rem; }
  .ref-group li { display: flex; align-items: baseline; gap: .6rem; font-size: .95rem; }
  .school { color: #555; width: 11rem; flex-shrink: 0; font-size: .88rem; }
  @media (max-width: 600px) { .school { width: 7rem; } }
</style>
