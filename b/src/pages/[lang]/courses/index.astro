---
import data from '../../../data/courses.json'; import CourseGraph from '../../../components/CourseGraph.astro'; import SiteHeader from '../../../components/SiteHeader.astro'; import SiteFooter from '../../../components/SiteFooter.astro'; import SeoHead from '../../../components/SeoHead.astro';
export function getStaticPaths(){return ['en','zh'].map(lang=>({params:{lang},props:{lang}}))} const runtimePath=Astro.url?.pathname??Astro.request?.url??''; const lang=runtimePath.includes('/zh/')?'zh':(((Astro.props??{}).lang??'en')==='zh'?'zh':'en'); const text=v=>typeof v==='string'?v:v?.[lang]??''; const draftNotice=lang==='zh'?'提示：建设中或待定课程仍在持续设计和校准中，页面内容仅供参考，不代表最终教学版本。':'Note: courses marked as under development or placeholder are still being designed and calibrated; the page content is for reference and does not represent the final teaching version.';
---
<!doctype html>
<html lang={lang}>
<head>
<SeoHead lang={lang} path="courses" title={`${text(data.meta.title)} · 55AA Security Lab`} description={text(data.meta.description)}/>
</head>
<body>
<SiteHeader lang={lang} blogHref="courses/"/>
<main>
<h1>{text(data.meta.title)}</h1>
<p class="notice">{draftNotice}</p>
<CourseGraph lang={lang}/></main>
<SiteFooter lang={lang}/>
</body>
</html>
<style>:global(*){box-sizing:border-box}:global(html){overflow-y:scroll}:global(body){min-height:100vh;display:flex;flex-direction:column;margin:0;background:#fff;color:#000;font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(main){flex:1;width:min(960px,calc(100% - 2rem));margin:0 auto;padding:1.5rem 0 2rem}h1{display:none;font-size:1.45rem;margin:0 0 1.2rem}.notice{max-width:56rem;margin:0 0 1rem;color:#555;font-size:.9rem}</style>
