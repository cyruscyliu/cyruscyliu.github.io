---
import data from '../../../data/courses.json'; import CourseGraph from '../../../components/CourseGraph.astro'; import SiteHeader from '../../../components/SiteHeader.astro'; import SiteFooter from '../../../components/SiteFooter.astro'; import SeoHead from '../../../components/SeoHead.astro';
import { isCourseIndexPageIndexable } from '../../../lib/course-indexing.js';
export function getStaticPaths(){return ['en','zh'].map(lang=>({params:{lang},props:{lang}}))} const runtimePath=Astro.url?.pathname??Astro.request?.url??''; const lang=runtimePath.includes('/zh/')?'zh':(((Astro.props??{}).lang??'en')==='zh'?'zh':'en'); const text=v=>typeof v==='string'?v:v?.[lang]??''; const indexable=isCourseIndexPageIndexable(data); const draftNotice=lang==='zh'?'课程区整体建设中：目前所有课程和课次均为规划草案，尚未正式发布，内容仅供参考。课程会在内容和材料完成审核后逐门发布。':'The entire course area is under development. All courses and lessons are planning drafts, have not been formally published, and are provided for reference only. Courses will be released individually after their content and materials are reviewed.';
---
<!doctype html>
<html lang={lang}>
<head>
<SeoHead lang={lang} path="courses" title={`${text(data.meta.title)} · 55AA Security Lab`} description={text(data.meta.description)} indexable={indexable}/>
</head>
<body>
<SiteHeader lang={lang} blogHref="courses/"/>
<main>
<h1>{text(data.meta.title)}</h1>
<p class="status">{text(data.meta.status)}</p>
<p class="notice">{draftNotice}</p>
<CourseGraph lang={lang}/></main>
<SiteFooter lang={lang}/>
</body>
</html>
<style>:global(*){box-sizing:border-box}:global(html){overflow-y:scroll}:global(body){min-height:100vh;display:flex;flex-direction:column;margin:0;background:#fff;color:#000;font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(main){flex:1;width:min(960px,calc(100% - 2rem));margin:0 auto;padding:1.5rem 0 2rem}h1{display:none;font-size:1.45rem;margin:0 0 1.2rem}.status{margin:0 0 .25rem;font-weight:600}.notice{max-width:56rem;margin:0 0 1rem;color:#555;font-size:.9rem}</style>
