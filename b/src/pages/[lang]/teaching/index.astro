---
import data from '../../../data/teaching.json'; import CourseGraph from '../../../components/CourseGraph.astro'; import SiteHeader from '../../../components/SiteHeader.astro'; import SiteFooter from '../../../components/SiteFooter.astro';
export function getStaticPaths(){return ['en','zh'].map(lang=>({params:{lang},props:{lang}}))} const runtimePath=Astro.url?.pathname??Astro.request?.url??''; const lang=runtimePath.includes('/zh/')?'zh':(((Astro.props??{}).lang??'en')==='zh'?'zh':'en'); const text=v=>typeof v==='string'?v:v?.[lang]??''; const canonical=`https://cyruscyliu.github.io/${lang}/teaching/`; const courses=[...data.courses].sort((a,b)=>(a.level.en==='Undergraduate'?0:1)-(b.level.en==='Undergraduate'?0:1));
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{text(data.meta.title)} · 55AA Security Lab</title><meta name="description" content={text(data.meta.description)}/><link rel="canonical" href={canonical}/></head><body><SiteHeader lang={lang} blogHref="teaching/"/><main><h1>{text(data.meta.title)}</h1><CourseGraph lang={lang}/>{courses.map(c=><article><p class="title">{text(c.name)} <span>{text(c.level)}</span> <span>{c.code}</span> <span>{text(c.status)}</span></p></article>)}</main><SiteFooter lang={lang}/></body></html>
<style>:global(*){box-sizing:border-box}:global(html){overflow-y:scroll}:global(body){min-height:100vh;display:flex;flex-direction:column;margin:0;background:#fff;color:#000;font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(main){flex:1;width:min(960px,calc(100% - 2rem));margin:0 auto;padding:1.5rem 0 2rem}h1{display:none;font-size:1.45rem;margin:0 0 1.2rem}.title{margin:0}.title span{color:#777;font-size:.8rem;margin-left:.5rem}article{margin:0 0 .65rem}main>h1+p{margin-top:0}</style>
