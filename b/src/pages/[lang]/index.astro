---
import home from '../../data/home.json';
import research from '../../data/research.json';
import people from '../../data/people.json';
import publications from '../../data/publications.json';
import projects from '../../data/projects.json';
import tools from '../../data/tools.json';
import teaching from '../../data/teaching.json';
import blog from '../../data/blog.json';
import news from '../../data/news.json';
import Preview from '../../components/Preview.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import CourseGraph from '../../components/CourseGraph.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import consultation from '../../data/consultation.json';
import sponsorship from '../../data/sponsorship.json';
import SeoHead from '../../components/SeoHead.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = (Astro.params.lang === 'zh' ? 'zh' : 'en') as 'en' | 'zh';
const text = (value: any) => typeof value === 'string' ? value : value?.[lang] ?? '';
const researchSummary = research.areas.map((area) => { const title = text(area.title); return lang === 'en' ? title.replace(/^[A-Z]/, (letter) => letter.toLowerCase()) : title; }).join(lang === 'zh' ? '、' : ', ');
const tabs = home.sections;
const labels = { en: { language: '中文', footer: '55AA Security Lab' }, zh: { language: 'English', footer: '55AA Security Lab' } }[lang];
const canonicalUrl = `https://cyruscyliu.github.io/${lang}/`;
const seoTitle = lang === 'zh' ? '55AA 安全实验室｜系统安全研究' : '55AA Security Lab — System Security Research';
const seoDescription = lang === 'zh' ? '55AA 安全实验室开展系统安全、软件安全、程序分析、人工智能智能体和安全工程研究。' : '55AA Security Lab conducts research in system security, software security, program analysis, AI agents, and security engineering.';
---
<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead lang={lang} title={seoTitle} description={seoDescription} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ResearchOrganization',
      name: lang === 'zh' ? '55AA 安全实验室' : '55AA Security Lab',
      url: canonicalUrl,
      logo: 'https://cyruscyliu.github.io/logo.svg',
      // Institutional affiliation and campus address are intentionally omitted
      // until written authorization for the public presentation is confirmed.
      knowsAbout: ['System security', 'Software security', 'Program analysis', 'AI agents', 'Security engineering']
    })} />
  </head>
  <body>
    <SiteHeader lang={lang} />
    <section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p id="hero-title" class="hero-intro">{lang === 'zh' ? `欢迎来到 55AA 安全实验室。我们围绕${researchSummary}开展研究，并将成果转化为课程、工具和服务。` : `Welcome to 55AA Security Lab. We work on ${researchSummary}, turning our findings into courses, tools, and services.`}</p></div><div class="hero-visual" aria-hidden="true"><canvas data-hero-canvas></canvas><div class="hero-fallback">01010101<br/>10101010</div><div class="byte-labels"><span>0x55</span><span>0xAA</span></div></div></section>
    <main>
      <section class="panel active" data-panel="home">
        <h2>News</h2>
        {news.entries.slice(0, 3).map((entry) => <article class="news-item"><time class="meta" datetime={entry.date}>{entry.date}</time><h2>{text(entry.title)}</h2></article>)}
        <Preview title={text(teaching.meta.title)} keyName="teaching" readMore={lang === 'zh' ? '查看更多' : 'Read more'}>{teaching.courses.slice(0, 3).map((course) => <article><div class="course-heading"><h2>{text(course.name)}</h2><span class="course-level">{text(course.level)}</span><span class="course-level">{course.code}</span><span class="course-level">{text(course.status)}</span><span class="course-level">{lang === 'zh' ? '开班时间：待定' : 'Course start: TBD'}</span></div></article>)}</Preview>
        <Preview title={text(projects.meta.title)} keyName="projects" readMore={lang === 'zh' ? '查看更多' : 'Read more'}>{projects.projects.slice(0, 3).map((project) => <article><div class="item-heading"><h2><a href={text(project.href)}>{text(project.title)}</a></h2><span class="item-tag">{text(project.tag)}</span><span class="item-tag">{lang === 'zh' ? '招募状态：待定' : 'Recruitment: TBD'}</span></div><p>{text(project.introduction) || (lang === 'zh' ? '待定' : 'TBD')}</p></article>)}</Preview>
        <Preview title={text(tools.meta.title)} keyName="tools" readMore={lang === 'zh' ? '查看更多' : 'Read more'}><div data-github-tools data-github-config={JSON.stringify(tools.tools)} data-limit="3">{tools.tools.slice(0, 3).map((tool) => <article><p class="tool-title"><a href={`https://github.com/${tool.repo}`} target="_blank" rel="noreferrer">{tool.fallbackTitle}</a> <span class="item-tag">GitHub</span><span class="item-tag">{lang === 'zh' ? '适用入口：GitHub' : 'Access: GitHub'}</span></p><p>{tool.fallbackDescription || (lang === 'zh' ? '待定' : 'TBD')}</p></article>)}</div></Preview>
        <Preview title={text(consultation.meta.title)} keyName="consultation" readMore={lang === 'zh' ? '查看更多' : 'Read more'}>
          <p>{text(consultation.body)}</p>
          {consultation.services.map((service) => <article><div class="item-heading"><h2>{text(service.title)}</h2><span class="item-tag">{text(service.duration)}</span><span class="item-tag">{lang === 'zh' ? '预约方式：联系实验室' : 'Booking: contact us'}</span></div></article>)}
        </Preview>
      </section>
      <section class="panel" data-panel="people">
        {people.people.map((person) => <article class="person"><img class="person-image" src={person.profileImage} alt={text(person.alt)} /><div class="person-info"><h2>{person.name}</h2><div class="person-details"><p class="person-role">{text(person.role)}</p><p class="person-interests">{person.interests[lang].join(' · ')}</p><p class="person-motto">{text(person.motto)}</p><div class="socials">{person.links.map((link) => <a href={link.url} aria-label={text(link.label)} title={text(link.label)}><SocialIcon kind={link.kind} /></a>)}</div></div></div></article>)}
      </section>
      <section class="panel" data-panel="publications">
        <div class="dblp-list" data-dblp-list data-dblp-rss={publications.dblp[0]?.rss ?? ''} data-language={lang}><p>{lang === 'zh' ? '正在加载 DBLP 论文…' : 'Loading DBLP publications…'}</p></div>
      </section>
      <section class="panel" data-panel="projects">{projects.projects.map((project) => <article><div class="item-heading"><h2><a href={text(project.href)}>{text(project.title)}</a></h2><span class="item-tag">{text(project.tag)}</span></div><p>{text(project.introduction) || (lang === 'zh' ? '待定' : 'TBD')}</p></article>)}</section>
      <section class="panel" data-panel="tools"><div data-github-tools data-github-config={JSON.stringify(tools.tools)}>{tools.tools.map((tool) => <article><p class="tool-title"><a href={`https://github.com/${tool.repo}`} target="_blank" rel="noreferrer">{tool.fallbackTitle}</a> <span class="item-tag">GitHub</span></p><p>{tool.fallbackDescription || (lang === 'zh' ? '待定' : 'TBD')}</p></article>)}</div></section>
      <section class="panel" data-panel="teaching"><CourseGraph lang={lang} />{[...teaching.courses].sort((a, b) => (a.level.en === 'Undergraduate' ? 0 : 1) - (b.level.en === 'Undergraduate' ? 0 : 1)).map((course) => <article><div class="course-heading"><h2>{text(course.name)}</h2><span class="course-level">{text(course.level)}</span><span class="course-level">{course.code}</span><span class="course-level">{text(course.status)}</span></div></article>)}</section>
      <section class="panel" data-panel="consultation"><p>{text(consultation.body)}</p>{consultation.services.map((service) => <article><div class="item-heading"><h2>{text(service.title)}</h2><span class="item-tag">{text(service.duration)}</span></div></article>)}</section>
      <section class="panel" data-panel="blog">{blog.entries.map((entry, index) => <article><p class="meta">{entry.date} · {text(entry.meta)}</p><h2><a href={`/${lang}/blog/${entry.date}-${index + 1}/`}>{text(entry.title)}</a></h2><p>{text(entry.body)}</p></article>)}</section>
      <section class="panel" data-panel="sponsorship"><p>{text(sponsorship.body)}</p><h2>{lang === 'zh' ? '赞助者列表' : 'Sponsors'}</h2>{sponsorship.sponsors.length ? sponsorship.sponsors.map((sponsor) => <p>{sponsor}</p>) : <p class="meta">{lang === 'zh' ? '暂无赞助者。' : 'No sponsors yet.'}</p>}</section>
    </main>
    <SiteFooter lang={lang} />
    <script>
      const canvas=document.querySelector('[data-hero-canvas]');
      if(canvas instanceof HTMLCanvasElement)(async()=>{const THREE=await import('three');const renderer=new THREE.WebGLRenderer({canvas,alpha:true,antialias:true});renderer.outputColorSpace=THREE.SRGBColorSpace;const scene=new THREE.Scene();const camera=new THREE.PerspectiveCamera(25,2.25,.1,100);camera.position.set(0,0,11);const group=new THREE.Group();scene.add(group);['01010101','10101010'].forEach((row,y)=>[...row].forEach((bit,x)=>{const material=new THREE.MeshPhysicalMaterial({color:bit==='1'?0x1769aa:0xc7d8e8,roughness:.48,metalness:.02,clearcoat:.12});const cube=new THREE.Mesh(new THREE.BoxGeometry(.66,.66,.22),material);cube.position.set((x-3.5)*.76+(x>3?.16:-.16),(y?-.42:.42),0);group.add(cube)}));scene.add(new THREE.HemisphereLight(0xffffff,0xd8e4ef,2.4));const light=new THREE.DirectionalLight(0xffffff,2.2);light.position.set(-3,5,7);scene.add(light);const resize=()=>{const w=canvas.clientWidth,h=canvas.clientHeight;renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix()};resize();new ResizeObserver(resize).observe(canvas);const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;let px=0,py=0;canvas.closest('.hero')?.addEventListener('pointermove',event=>{const rect=canvas.getBoundingClientRect();px=(event.clientX-rect.left)/rect.width-.5;py=(event.clientY-rect.top)/rect.height-.5});const render=(time=0)=>{group.rotation.x=-.13+(reduce?0:py*.09);group.rotation.y=.14+(reduce?0:px*.13+Math.sin(time*.0002)*.025);renderer.render(scene,camera);if(!reduce)requestAnimationFrame(render)};render();canvas.classList.add('ready')})().catch(()=>{});
    </script>
    <script>
      const buttons = [...document.querySelectorAll('.tab')];
      const panels = [...document.querySelectorAll('.panel')];
      const languageLink = document.querySelector('[data-language-link]');
      const syncLanguageLink = () => {
        if (languageLink) languageLink.href = languageLink.pathname + location.hash;
      };
      syncLanguageLink();
      const selectTab = (button, updateUrl = true) => {
        const key = button.dataset.tab;
        buttons.forEach((item) => { const selected = item === button; item.classList.toggle('active', selected); item.setAttribute('aria-selected', String(selected)); });
        panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === key));
        if (updateUrl && key) history.replaceState(null, '', `#${key}`);
        syncLanguageLink();
      };
      buttons.forEach((button) => button.addEventListener('click', () => selectTab(button)));
      const initialKey = location.hash.slice(1);
      const initialButton = buttons.find((button) => button.dataset.tab === initialKey);
      if (initialButton) selectTab(initialButton, false);
      window.addEventListener('hashchange', () => {
        const button = buttons.find((item) => item.dataset.tab === location.hash.slice(1));
        if (button) selectTab(button, false);
        syncLanguageLink();
      });
      const githubTools = {tools: JSON.parse(document.querySelector('[data-github-config]')?.dataset.githubConfig || '[]')};
      const githubToolsKey = '55aa:github-tools:v1';
      const githubToolsTtl = 6 * 60 * 60 * 1000;
      let githubToolsCache; try { githubToolsCache = JSON.parse(localStorage.getItem(githubToolsKey) || 'null'); } catch {}
      const githubToolsFetch = (!githubToolsCache?.savedAt || Date.now() - githubToolsCache.savedAt > githubToolsTtl)
        ? Promise.all(githubTools.tools.map((t) => fetch(`https://api.github.com/repos/${t.repo}`).then((r) => r.ok ? r.json() : Promise.reject(r.status))))
            .then((items) => { try { localStorage.setItem(githubToolsKey, JSON.stringify({savedAt: Date.now(), items})); } catch {} return items; })
            .catch(() => githubToolsCache?.items || [])
        : Promise.resolve(githubToolsCache.items || []);
      document.querySelectorAll('[data-github-tools]').forEach((container) => {
        const limit = Number(container.dataset.limit || githubTools.tools.length);
        const render = (items) => { container.innerHTML = items.slice(0, limit).map((x) => `<article><p class="tool-title"><a href="${x.html_url}" target="_blank" rel="noreferrer">${x.name}</a> <span class="item-tag">GitHub</span></p><p>${x.description || (document.documentElement.lang === 'zh' ? '待定' : 'TBD')}</p></article>`).join(''); };
        if (githubToolsCache?.items?.length) render(githubToolsCache.items);
        githubToolsFetch.then(render);
      });
      const publicationList = document.querySelector('[data-dblp-list]');
      const publicationPreview = document.querySelector('[data-dblp-preview]');
      if (publicationList) {
        const rss = publicationList.dataset.dblpRss;
        const lang = publicationList.dataset.language === 'zh' ? 'zh' : 'en';
        const api = rss ? `https://r.jina.ai/${rss}` : '';
        const cacheKey = `55aa:dblp:v2:${rss}`;
        const cacheTtl = 60 * 60 * 1000;
        const showMessage = (message) => {
          publicationList.innerHTML = `<p>${message}</p>`;
          if (publicationPreview) publicationPreview.innerHTML = publicationList.innerHTML;
        };
        const render = (items) => {
          const html = items.map((item) => `<article><p class="publication-title"><a href="${item.url}" target="_blank" rel="noreferrer">${item.title}</a></p><p class="publication-authors">${item.authors || ''}</p><p class="meta">${item.venue || ''}${item.year ? ` · ${item.year}` : ''}</p></article>`).join('');
          publicationList.innerHTML = html || `<p>${lang === 'zh' ? '暂无 DBLP 论文。' : 'No DBLP publications found.'}</p>`;
          if (publicationPreview) publicationPreview.innerHTML = html ? html.split('</article>').slice(0, 3).join('</article>') : publicationList.innerHTML;
        };
        const cached = (() => { try { return JSON.parse(localStorage.getItem(cacheKey) || 'null'); } catch { return null; } })();
        if (cached?.items?.length) render(cached.items);
        const shouldRefresh = !cached?.savedAt || Date.now() - cached.savedAt > cacheTtl;
        if (shouldRefresh) fetch(api).then((response) => response.text()).then((raw) => {
          const items = [...raw.matchAll(/<item>([\s\S]*?)<\/item>/g)].map((match) => {
            const block = match[1];
            const get = (tag) => block.match(new RegExp(`<${tag}>([\\s\\S]*?)<\\/${tag}>`))?.[1]?.trim() ?? '';
            const clean = (value) => value.replace(/<!\[CDATA\[/g, '').replace(/\]\]>/g, '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
            const description = get('description');
            const authorBlock = description.split('<br>')[0] || '';
            const authors = [...authorBlock.matchAll(/itemprop="name"[^>]*>([^<]+)</g)].map((match) => match[1].trim());
            const afterAuthors = description.split('<br>')[1] || '';
            const venue = afterAuthors.match(/itemprop="isPartOf"[\s\S]*?itemprop="name"[^>]*>([^<]+)</)?.[1]?.trim() || '';
            const year = description.match(/itemprop="datePublished"[^>]*>([^<]+)</)?.[1]?.trim() || '';
            const authorHtml = authors.map((author) => author === 'Qiang Liu' ? `<strong>${author}</strong>` : author).join(', ');
            const title = clean(get('title')).replace(/[.]$/, '');
            return { title, url: get('link'), authors: authorHtml, venue, year };
          });
          return items;
        }).then((data) => {
          render(data);
          try { localStorage.setItem(cacheKey, JSON.stringify({ savedAt: Date.now(), items: data })); } catch {}
        }).catch(() => {
          if (!cached?.items?.length) showMessage(lang === 'zh' ? 'DBLP 论文暂时无法加载。' : 'DBLP publications are temporarily unavailable.');
        });
      }
      document.querySelectorAll('[data-goto]').forEach((link) => link.addEventListener('click', () => {
        document.querySelector(`.tab[data-tab="${link.dataset.goto}"]`)?.click();
      }));
      if (document.querySelector('.mermaid')) {
        import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(({ default: mermaid }) => {
          mermaid.initialize({ startOnLoad: false, theme: 'base', securityLevel: 'strict', fontFamily: 'system-ui, sans-serif' });
          mermaid.run({ nodes: document.querySelectorAll('.mermaid') });
        });
      }
    </script>
  </body>
</html>
<style>
.hero{position:relative;isolation:isolate;display:flex;justify-content:space-between;align-items:center;gap:2rem;width:min(960px,calc(100% - 2rem));margin:2rem auto 3rem;padding:2.5rem 1.5rem;border-bottom:1px solid #eee;background:url('/hero-background.svg') center/cover no-repeat;overflow:hidden}.hero:after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.9),rgba(255,255,255,.5) 52%,rgba(255,255,255,0))}.hero-copy{max-width:40rem}.hero-intro{margin:0;line-height:1.7}.hero-visual{position:relative;width:18rem;height:8rem;flex:none}.hero-visual canvas{display:block;width:100%;height:100%;opacity:0}.hero-visual canvas.ready{opacity:1}.hero-fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#06c;font:600 1.2rem/1.05 monospace;white-space:nowrap}.hero-visual canvas.ready+.hero-fallback{display:none}.byte-labels{position:absolute;left:0;right:0;bottom:-.15rem;display:flex;justify-content:center;gap:4.7rem;color:#777;font:500 .68rem/1 system-ui;letter-spacing:.04em}@media(max-width:600px){.hero{margin-top:1rem;padding:1.5rem 0}.hero-visual{width:10rem;height:5rem}}
</style>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { overflow-y: scroll; }
  :global(body) { min-height: 100vh; display: flex; flex-direction: column; margin: 0; background: #fff; color: #000; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 16px; line-height: 1.55; }
  .site-header, main, footer { width: min(960px, calc(100% - 2rem)); margin-inline: auto; }
  main { flex: 1; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 0; }
  .brand-lockup { display: flex; align-items: center; gap: 1rem; }
  .gbu-logo { display: inline-flex; align-items: center; }
  .gbu-logo img { display: block; width: auto; height: 2rem; }
  .site-name { display: inline-flex; align-items: center; gap: .55rem; color: #000; font-weight: 600; text-decoration: none; }
  .site-name img { width: 2rem; height: 2rem; }
  .wordmark { display: flex; flex-direction: column; line-height: 1.05; margin: 0; padding: 0; font-family: inherit; font-size: 1rem; font-weight: 400; }
  .wordmark span:first-child { font-size: 1rem; font-weight: 600; }
  .wordmark span:last-child { font-size: .8rem; }
  a { color: #06c; }
  .language { font-size: .9rem; }
  .tabs { display: flex; flex-wrap: wrap; gap: .25rem 1.1rem; padding: .35rem 0; }
  .tab { border: 0; background: none; color: #06c; cursor: pointer; font: inherit; padding: .25rem 0; }
  .tab.active { color: #000; font-weight: 600; }
  .panel { display: none; padding: 1.5rem 0 2rem; }
  .panel.active { display: block; }
  h1 { font-size: 1.45rem; font-weight: 600; margin: 0 0 1.2rem; }
  h2 { font-size: 1.05rem; font-weight: 600; margin: 0 0 .25rem; }
  .research-title { font-weight: 600; }
  .research-item h2 { margin: 0 0 .25rem; }
  .research-item p { margin: 0; }
  article { margin: 0 0 1.35rem; }
  .news-item { margin-bottom: .9rem; }
  .news-item time, .news-item h2 { display: block; }
  .news-item h2 { margin: .15rem 0 0; font-weight: 400; }
  .panel[data-panel="home"] > h2 { margin-top: 2.75rem; }
  .panel[data-panel="home"] > h2:first-child { margin-top: 0; }
  .preview { margin-top: 2.75rem; }
  .read-more { border: 0; background: none; color: #06c; cursor: pointer; padding: 0; font: inherit; }
  p { margin: .25rem 0 .65rem; }
  .tags, .meta { color: #555; font-size: .9rem; }
  .course-heading { display: flex; align-items: baseline; gap: .5rem; }
  .course-heading h2 { margin: 0; }
  .course-level { color: #777; font-size: .8rem; }
  .item-heading { display: flex; align-items: baseline; gap: .5rem; }
  .item-heading h2 { margin: 0; }
  .item-tag { color: #777; font-size: .8rem; }
  .course-description { white-space: nowrap; }
  :global(.dblp-preview), :global(.dblp-list) { min-height: 1.55em; margin: 0; padding: 0; }
  :global(.dblp-list article), :global(.dblp-preview article) { margin: 0 0 1.35rem; }
  :global(.dblp-list p), :global(.dblp-preview p) { margin: 0; padding: 0; font-size: 1rem; line-height: 1.55; }
  :global(.dblp-list .publication-title), :global(.dblp-preview .publication-title) { font-weight: 600; }
  :global(.dblp-list a), :global(.dblp-preview a) { color: #06c !important; }
  :global(.tool-title) { margin: 0; padding: 0; font-size: 1rem; line-height: 1.55; font-weight: 600; }
  :global(.tool-title a) { color: #06c; }
  :global(.tool-title .item-tag) { color: #777; font-size: .8rem; font-weight: 400; }
  :global([data-github-tools] article) { margin: 0 0 1.35rem; }
  :global([data-github-tools] article > p) { margin: 0; padding: 0; font-size: 1rem; line-height: 1.55; }
  .person { display: flex; align-items: flex-start; gap: 1.25rem; }
  .person-image { display: block; flex: 0 0 auto; width: 144px; height: 144px; object-fit: cover; }
  .person-info { min-height: 144px; display: flex; flex-direction: column; justify-content: space-between; padding-top: .05rem; }
  .person-info h2 { margin: 0; }
  .person-details { display: flex; flex-direction: column; gap: .15rem; }
  .person-role, .person-interests, .person-motto { margin: 0; }
  .socials { display: flex; align-items: center; gap: .4rem; margin-top: .2rem; }
  .socials a { display: inline-flex; align-items: center; justify-content: center; width: 1.35rem; height: 1.35rem; text-decoration: none; }
  footer { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0 2rem; color: #555; font-size: .9rem; }
  .footer-upper { align-items: flex-start; padding: 2rem 0 1.25rem; border-top: 1px solid #eee; color: #555; }
  .footer-identity p { margin: .75rem 0 0; }
  .footer-logos { display: flex; align-items: center; gap: 1rem; }
  .footer-logos a { display: inline-flex; align-items: center; }
  .footer-logos a:first-child img { width: auto; height: 2rem; }
  .footer-logos a:last-child img { width: 2.5rem; height: 2.5rem; }
  .footer-site-mark { display: inline-flex; align-items: center; gap: .55rem; color: #000; }
  .footer-site-mark img { width: 2.5rem; height: 2.5rem; }
  .footer-site-mark > span { display: flex; flex-direction: column; line-height: 1.05; }
  .footer-site-mark > span > strong { font-size: 1rem; font-weight: 600; }
