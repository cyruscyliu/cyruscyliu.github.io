---
import home from '../../data/home.json';
import research from '../../data/research.json';
import people from '../../data/people.json';
import dblp from '../../data/dblp.json';
import projects from '../../data/projects.json';
import tools from '../../data/tools.json';
import toolsCache from '../../data/tools-cache.json';
import teaching from '../../data/courses.json';
import blog from '../../data/blog.json';
import news from '../../data/news.json';
import Preview from '../../components/Preview.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import CourseGraph from '../../components/CourseGraph.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import consultation from '../../data/consultation.json';
import sponsorship from '../../data/sponsorship.json';
import SeoHead from '../../components/SeoHead.astro';
import PublicationList from '../../components/PublicationList.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = (Astro.params.lang === 'zh' ? 'zh' : 'en') as 'en' | 'zh';
const text = (value: any) => typeof value === 'string' ? value : value?.[lang] ?? '';
const researchSummary = research.areas.map((area) => { const title = text(area.title); return lang === 'en' ? title.replace(/^[A-Z]/, (letter) => letter.toLowerCase()) : title; }).join(lang === 'zh' ? '、' : ', ');
const tabs = home.sections;
const labels = { en: { language: '中文', footer: '55AA Security Lab' }, zh: { language: 'English', footer: '55AA Security Lab' } }[lang];
const canonicalUrl = `https://cyruscyliu.github.io/${lang}/`;
const seoTitle = lang === 'zh' ? '55AA 安全实验室｜系统安全研究' : '55AA Security Lab — System Security Research';
const seoDescription = lang === 'zh' ? '55AA 安全实验室开展系统安全、软件安全、程序分析、人工智能智能体和安全工程研究。' : '55AA Security Lab conducts research in system security, software security, program analysis, AI agents, and security engineering.';
const today = new Date().toISOString().slice(0, 10);
const publishedNews = news.entries.filter((entry) => entry.date <= today);
const hiringProjects = projects.projects.filter((project) => project.tag?.en?.includes('Hiring for'));
const publishedCourses = teaching.courses.filter((course) => !['Under development', 'Placeholder'].includes(course.status?.en));
const noPublishedCoursesText = lang === 'zh' ? '暂无已发布课程。' : 'No published courses yet.';
const displayTools = tools.tools.map((tool) => {
  const cached = toolsCache.tools[tool.repo];
  return {
    ...tool,
    fallbackTitle: cached?.title || tool.fallbackTitle,
    fallbackDescription: cached?.description || tool.fallbackDescription,
  };
});
---
<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead lang={lang} title={seoTitle} description={seoDescription} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ResearchOrganization',
      name: lang === 'zh' ? '55AA 安全实验室' : '55AA Security Lab',
      url: canonicalUrl,
      logo: 'https://cyruscyliu.github.io/logo.svg',
      // Institutional affiliation and campus address are intentionally omitted
      // until written authorization for the public presentation is confirmed.
      knowsAbout: ['System security', 'Software security', 'Program analysis', 'AI agents', 'Security engineering']
    })} />
  </head>
  <body>
    <SiteHeader lang={lang} />
    <section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p id="hero-title" class="hero-intro">{lang === 'zh' ? `欢迎来到 55AA 安全实验室。我们围绕${researchSummary}开展研究，并将成果转化为课程、工具和服务。` : `Welcome to 55AA Security Lab. We work on ${researchSummary}, turning our findings into courses, tools, and services.`}</p></div><div class="hero-visual" aria-hidden="true"><svg class="hero-map" viewBox="0 0 360 220" role="presentation" focusable="false"><defs><filter id="hero-map-shadow" x="-14%" y="-18%" width="128%" height="136%"><feDropShadow dx="0" dy="10" stdDeviation="9" flood-color="#0b3a63" flood-opacity=".11"/></filter></defs><rect x="18" y="24" width="324" height="172" rx="16" fill="#fff" opacity=".78"/><g filter="url(#hero-map-shadow)"><path d="M38 76 82 50 126 58 144 106 112 152 58 144 30 110Z" fill="#eef6fc" stroke="#9cc5e6" stroke-width="2"/><path d="M126 60 206 44 264 86 246 148 164 160 136 112Z" fill="#f7fbff" stroke="#b8d3ea" stroke-width="2"/><path d="M238 72 312 84 334 124 306 168 238 176 214 126Z" fill="#edf7f4" stroke="#a9d4c9" stroke-width="2"/></g><g fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M64 110 C108 92 132 104 170 112 S234 102 292 122" stroke="#8ab5d9" stroke-width="3"/><path d="M108 142 C150 130 188 146 236 130" stroke="#b3cce3" stroke-width="2.2"/><path d="M68 78 C100 100 126 116 170 112 S250 112 292 122" stroke="#d93025" stroke-width="3.2" stroke-dasharray="8 8"/></g><g><circle cx="64" cy="110" r="6" fill="#06c"/><circle cx="108" cy="142" r="4.5" fill="#06c"/><circle cx="170" cy="112" r="8" fill="#fff" stroke="#06c" stroke-width="3"/><circle cx="236" cy="130" r="5" fill="#06c"/><circle cx="292" cy="122" r="12" fill="#111"/><circle cx="68" cy="78" r="5.5" fill="#d93025"/><circle cx="126" cy="106" r="4" fill="#d93025"/><path d="m208 82 9 9-9 9-9-9z" fill="#fff" stroke="#f4b400" stroke-width="2.4"/><path d="M286 116h12v12h-12z" fill="#fff"/></g><g fill="none" stroke="#0b3155" stroke-opacity=".14" stroke-width="1.3"><path d="M48 132c26 12 54 14 84 6"/><path d="M154 76c30-8 58-4 84 12"/><path d="M250 154c22 2 42-2 60-14"/></g></svg></div></section>
    <main>
      <section class="panel active" data-panel="home">
        <h2>News</h2>
        {publishedNews.length ? publishedNews.slice(0, 3).map((entry) => <article class="news-item"><time class="meta" datetime={entry.date}>{entry.date}</time><h2>{text(entry.title)}</h2></article>) : <p class="meta">{lang === 'zh' ? '暂无新闻。' : 'No news yet.'}</p>}
        <Preview title={text(teaching.meta.title)} keyName="courses" readMore={lang === 'zh' ? '查看更多' : 'Read more'}>{publishedCourses.length ? publishedCourses.slice(0, 3).map((course) => <article><div class="course-heading"><h2>{text(course.name)}</h2><span class="course-level">{text(course.level)}</span><span class="course-level">{course.code}</span><span class="course-level">{text(course.status)}</span><span class="course-level">{lang === 'zh' ? '开班时间：待定' : 'Course start: TBD'}</span></div></article>) : <p class="meta">{noPublishedCoursesText}</p>}</Preview>
        <Preview title={text(projects.meta.title)} keyName="projects" readMore={lang === 'zh' ? '查看更多' : 'Read more'}>{hiringProjects.slice(0, 3).map((project) => <article><div class="item-heading"><h2><a href={text(project.href)}>{text(project.title)}</a></h2><span class="item-tag">{text(project.tag)}</span></div><p>{text(project.introduction) || (lang === 'zh' ? '待定' : 'TBD')}</p></article>)}</Preview>
        <Preview title={text(tools.meta.title)} keyName="tools" readMore={lang === 'zh' ? '查看更多' : 'Read more'}><div>{displayTools.slice(0, 3).map((tool) => <article><p class="tool-title"><a href={`https://github.com/${tool.repo}`} target="_blank" rel="noreferrer">{tool.fallbackTitle}</a> <span class="item-tag">GitHub</span><span class="item-tag">{lang === 'zh' ? '适用入口：GitHub' : 'Access: GitHub'}</span></p><p>{tool.fallbackDescription || (lang === 'zh' ? '待定' : 'TBD')}</p></article>)}</div></Preview>
        <Preview title={text(consultation.meta.title)} keyName="consultation" readMore={lang === 'zh' ? '查看更多' : 'Read more'}>
          <p>{text(consultation.body)}</p>
          {consultation.services.map((service) => <article><div class="item-heading"><h2>{text(service.title)}</h2><span class="item-tag">{text(service.duration)}</span><span class="item-tag">{lang === 'zh' ? '预约方式：联系实验室' : 'Booking: contact us'}</span></div></article>)}
        </Preview>
      </section>
      <section class="panel" data-panel="people">
        <div class="people-grid">{people.people.map((person) => <article class="person-card">{person.profile ? <a class="person-image-link" href={`/${lang}/people/${person.profile.slug}/`}><img class="person-image" src={person.profileImage} alt={text(person.alt)} /></a> : <img class="person-image" src={person.profileImage} alt={text(person.alt)} />}<div class="person-info"><div>{person.profile ? <h2><a class="person-name" href={`/${lang}/people/${person.profile.slug}/`}>{person.name}</a></h2> : <h2>{person.name}</h2>}<p class="person-role">{text(person.role)}</p></div><p class="person-interests">{person.interests[lang].join(' · ')}</p><div class="socials">{person.cv && <a class="cv-link" href={person.cv} target="_blank" rel="noreferrer">CV</a>}{person.links.map((link) => <a href={link.url} aria-label={text(link.label)} title={text(link.label)}><SocialIcon kind={link.kind} /></a>)}</div></div></article>)}</div>
      </section>
      <section class="panel" data-panel="publications">
        <PublicationList lang={lang} publications={dblp.publications} />
      </section>
      <section class="panel" data-panel="projects">{hiringProjects.map((project) => <article><div class="item-heading"><h2><a href={text(project.href)}>{text(project.title)}</a></h2><span class="item-tag">{text(project.tag)}</span></div><p>{text(project.introduction) || (lang === 'zh' ? '待定' : 'TBD')}</p></article>)}</section>
      <section class="panel" data-panel="tools"><div>{displayTools.map((tool) => <article><p class="tool-title"><a href={`https://github.com/${tool.repo}`} target="_blank" rel="noreferrer">{tool.fallbackTitle}</a> <span class="item-tag">GitHub</span></p><p>{tool.fallbackDescription || (lang === 'zh' ? '待定' : 'TBD')}</p></article>)}</div></section>
      <section class="panel" data-panel="courses">{publishedCourses.length ? <><CourseGraph lang={lang} includeDraft={false} />{[...publishedCourses].sort((a, b) => (a.level.en === 'Undergraduate' ? 0 : 1) - (b.level.en === 'Undergraduate' ? 0 : 1)).map((course) => <article><div class="course-heading"><h2>{text(course.name)}</h2><span class="course-level">{text(course.level)}</span><span class="course-level">{course.code}</span><span class="course-level">{text(course.status)}</span></div></article>)}</> : <p class="meta">{noPublishedCoursesText}</p>}</section>
      <section class="panel" data-panel="consultation"><p>{text(consultation.body)}</p>{consultation.services.map((service) => <article><div class="item-heading"><h2>{text(service.title)}</h2><span class="item-tag">{text(service.duration)}</span></div></article>)}</section>
      <section class="panel" data-panel="blog">{blog.entries.length ? blog.entries.map((entry, index) => <article><p class="meta">{entry.date} · {text(entry.meta)}</p><h2><a href={`/${lang}/blog/${entry.date}-${index + 1}/`}>{text(entry.title)}</a></h2><p>{text(entry.body)}</p></article>) : <p class="meta">{lang === 'zh' ? '暂无博客。' : 'No blog yet.'}</p>}</section>
      <section class="panel" data-panel="sponsorship"><p>{text(sponsorship.body)}</p><h2>{lang === 'zh' ? '赞助者列表' : 'Sponsors'}</h2>{sponsorship.sponsors.length ? sponsorship.sponsors.map((sponsor) => <p>{sponsor}</p>) : <p class="meta">{lang === 'zh' ? '暂无赞助者。' : 'No sponsors yet.'}</p>}</section>
    </main>
    <SiteFooter lang={lang} />
    <script>
      const buttons = [...document.querySelectorAll('.tab')];
      const panels = [...document.querySelectorAll('.panel')];
      const languageLink = document.querySelector('[data-language-link]');
      const syncLanguageLink = () => {
        if (languageLink) languageLink.href = languageLink.pathname + location.hash;
      };
      syncLanguageLink();
      const selectTab = (button, updateUrl = true) => {
        const key = button.dataset.tab;
        buttons.forEach((item) => { const selected = item === button; item.classList.toggle('active', selected); item.setAttribute('aria-selected', String(selected)); });
        panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === key));
        if (updateUrl && key) history.replaceState(null, '', `#${key}`);
        syncLanguageLink();
      };
      buttons.forEach((button) => button.addEventListener('click', () => selectTab(button)));
      const initialKey = location.hash.slice(1);
      const initialButton = buttons.find((button) => button.dataset.tab === initialKey);
      if (initialButton) selectTab(initialButton, false);
      window.addEventListener('hashchange', () => {
        const button = buttons.find((item) => item.dataset.tab === location.hash.slice(1));
        if (button) selectTab(button, false);
        syncLanguageLink();
      });
      document.querySelectorAll('[data-goto]').forEach((link) => link.addEventListener('click', () => {
        document.querySelector(`.tab[data-tab="${link.dataset.goto}"]`)?.click();
      }));
    </script>
  </body>
</html>
<style>
.hero{position:relative;isolation:isolate;display:flex;justify-content:space-between;align-items:center;gap:2rem;width:min(960px,calc(100% - 2rem));margin:2rem auto 3rem;padding:2.5rem 1.5rem;border-bottom:1px solid #eee;background:url('/hero-background.svg') center/cover no-repeat;overflow:hidden}.hero:after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.92),rgba(255,255,255,.56) 52%,rgba(255,255,255,0))}.hero-copy{flex:1 1 40rem;max-width:40rem;min-width:0}.hero-intro{margin:0;line-height:1.7;overflow-wrap:break-word}.hero-visual{position:relative;width:16rem;height:auto;flex:0 0 16rem}.hero-map{display:block;width:100%;height:auto;aspect-ratio:18/11}@media(max-width:600px){.hero{flex-direction:column;align-items:flex-start;margin-top:1rem;padding:1.5rem 0;gap:1.15rem}.hero-copy{width:100%;max-width:none;min-width:0;flex:none}.hero-visual{width:100%;max-width:22rem;flex:none}.hero-map{aspect-ratio:18/11}}
</style>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { overflow-y: scroll; }
  :global(body) { min-height: 100vh; display: flex; flex-direction: column; margin: 0; background: #fff; color: #000; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 16px; line-height: 1.55; }
  .site-header, main, footer { width: min(960px, calc(100% - 2rem)); margin-inline: auto; }
  main { flex: 1; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 0; }
  .brand-lockup { display: flex; align-items: center; gap: 1rem; }
  .gbu-logo { display: inline-flex; align-items: center; }
  .gbu-logo img { display: block; width: auto; height: 2rem; }
  .site-name { display: inline-flex; align-items: center; gap: .55rem; color: #000; font-weight: 600; text-decoration: none; }
  .site-name img { width: 2rem; height: 2rem; }
  .wordmark { display: flex; flex-direction: column; line-height: 1.05; margin: 0; padding: 0; font-family: inherit; font-size: 1rem; font-weight: 400; }
  .wordmark span:first-child { font-size: 1rem; font-weight: 600; }
  .wordmark span:last-child { font-size: .8rem; }
  a { color: #06c; }
  .language { font-size: .9rem; }
  .tabs { display: flex; flex-wrap: wrap; gap: .25rem 1.1rem; padding: .35rem 0; }
  .tab { border: 0; background: none; color: #06c; cursor: pointer; font: inherit; padding: .25rem 0; }
  .tab.active { color: #000; font-weight: 600; }
  .panel { display: none; padding: 1.5rem 0 2rem; }
  .panel.active { display: block; }
  h1 { font-size: 1.45rem; font-weight: 600; margin: 0 0 1.2rem; }
  h2 { font-size: 1.05rem; font-weight: 600; margin: 0 0 .25rem; }
  .research-title { font-weight: 600; }
  .research-item h2 { margin: 0 0 .25rem; }
  .research-item p { margin: 0; }
  article { margin: 0 0 1.35rem; }
  .news-item { margin-bottom: .9rem; }
  .news-item time, .news-item h2 { display: block; }
  .news-item h2 { margin: .15rem 0 0; font-weight: 400; }
  .panel[data-panel="home"] > h2 { margin-top: 2.75rem; }
  .panel[data-panel="home"] > h2:first-child { margin-top: 0; }
  .preview { margin-top: 2.75rem; }
  .read-more { border: 0; background: none; color: #06c; cursor: pointer; padding: 0; font: inherit; }
  p { margin: .25rem 0 .65rem; }
  .tags, .meta { color: #555; font-size: .9rem; }
  .course-heading { display: flex; align-items: baseline; gap: .5rem; }
  .course-heading h2 { margin: 0; }
  .course-level { color: #777; font-size: .8rem; }
  .item-heading { display: flex; align-items: baseline; gap: .5rem; }
  .item-heading h2 { margin: 0; }
  .item-tag { color: #777; font-size: .8rem; }
  .course-description { white-space: nowrap; }
  :global(.tool-title) { margin: 0; padding: 0; font-size: 1rem; line-height: 1.55; font-weight: 600; }
  :global(.tool-title a) { color: #06c; }
  :global(.tool-title .item-tag) { color: #777; font-size: .8rem; font-weight: 400; }
  :global([data-github-tools] article) { margin: 0 0 1.35rem; }
  :global([data-github-tools] article > p) { margin: 0; padding: 0; font-size: 1rem; line-height: 1.55; }
  .people-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .person-card { display: flex; align-items: flex-start; gap: 1rem; min-width: 0; margin: 0; padding: 1rem; background: rgba(255,255,255,.86); }
  .person-image-link { display: block; flex: 0 0 auto; }
  .person-image { display: block; width: 104px; height: 104px; object-fit: cover; }
  .person-name { color: inherit; text-decoration: none; }
  .person-name:hover { text-decoration: underline; }
  .person-info { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: .3rem; }
  .person-info h2 { margin: 0; }
  .person-role, .person-interests { margin: 0; }
  .person-role { color: #555; }
  .person-interests { color: #333; font-size: .92rem; }
  .socials { display: flex; align-items: center; gap: .4rem; margin-top: .2rem; }
  .socials a { display: inline-flex; align-items: center; justify-content: center; width: 1.35rem; height: 1.35rem; text-decoration: none; }
  footer { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0 2rem; color: #555; font-size: .9rem; }
  .footer-upper { align-items: flex-start; padding: 2rem 0 1.25rem; border-top: 1px solid #eee; color: #555; }
  .footer-identity p { margin: .75rem 0 0; }
  .footer-logos { display: flex; align-items: center; gap: 1rem; }
  .footer-logos a { display: inline-flex; align-items: center; }
  .footer-logos a:first-child img { width: auto; height: 2rem; }
  .footer-logos a:last-child img { width: 2.5rem; height: 2.5rem; }
  .footer-site-mark { display: inline-flex; align-items: center; gap: .55rem; color: #000; }
  .footer-site-mark img { width: 2.5rem; height: 2.5rem; }
  .footer-site-mark > span { display: flex; flex-direction: column; line-height: 1.05; }
  .footer-site-mark > span > strong { font-size: 1rem; font-weight: 600; }
  .footer-site-mark > span > span { font-size: .8rem; font-weight: 400; }
  .footer-social { display: flex; gap: .75rem; }
  .qr-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 5.5rem; height: 5.5rem; border: 1px dashed #aaa; color: #777; text-align: center; }
  .qr-placeholder span { font-size: .85rem; }
  .qr-placeholder small { margin-top: .25rem; font-size: .65rem; }
  @media (max-width: 600px) {
    .footer-upper { flex-wrap: wrap; }
    footer { flex-wrap: wrap; }
    .course-description { white-space: normal; }
    .brand-lockup { gap: .65rem; }
    .gbu-logo img { height: 1.6rem; }
    .site-name img { width: 1.75rem; height: 1.75rem; }
    .people-grid { grid-template-columns: 1fr; }
    .person-card { padding: .9rem; }
    .person-image { width: 88px; height: 88px; }
  }
</style>
