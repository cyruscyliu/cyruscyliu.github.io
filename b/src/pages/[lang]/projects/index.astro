---
import data from '../../../data/projects.json'; import SiteHeader from '../../../components/SiteHeader.astro'; import SiteFooter from '../../../components/SiteFooter.astro'; import SeoHead from '../../../components/SeoHead.astro';
export function getStaticPaths(){return ['en','zh'].map(lang=>({params:{lang},props:{lang}}))} const runtimePath=Astro.url?.pathname??Astro.request?.url??''; const lang=runtimePath.includes('/zh/')?'zh':(((Astro.props??{}).lang??'en')==='zh'?'zh':'en'); const text=v=>typeof v==='string'?v:v?.[lang]??''; const canonical=`https://cyruscyliu.github.io/${lang}/projects/`;
---
<!doctype html>
<html lang={lang}>
<head>
<SeoHead lang={lang} path="projects" title={`${text(data.meta.title)} · 55AA Security Lab`} description={text(data.meta.description)}/>
</head>
<body>
<SiteHeader lang={lang} blogHref="projects/"/>
<main>
<h1>{text(data.meta.title)}</h1>{data.projects.map(p=>
<article>
<p class="title">
<a href={p.id === 'aero-space-security-survey' ? `/${lang}/projects/aero-space-security/` : text(p.href)}>{text(p.title)}</a> <span>{text(p.tag)}</span>
</p>
<p>{text(p.introduction) || (lang === 'zh' ? '待定' : 'TBD')}</p>
</article>)}</main>
<SiteFooter lang={lang}/>
</body>
</html>
<style>:global(*){box-sizing:border-box}:global(html){overflow-y:scroll}:global(body){min-height:100vh;display:flex;flex-direction:column;margin:0;background:#fff;color:#000;font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(main){flex:1;width:min(960px,calc(100% - 2rem));margin:0 auto;padding:1.5rem 0 2rem}h1{display:none;font-size:1.45rem;margin:0 0 1.2rem}.title{margin:0;font-weight:600}.title a{color:#06c}.title span{color:#777;font-size:.8rem;font-weight:400}article{margin:0 0 1.35rem}p{margin:.25rem 0 .65rem}main>h1+p{margin-top:0}</style>
