---
import news from '../../../data/news.json'; import SiteHeader from '../../../components/SiteHeader.astro'; import SiteFooter from '../../../components/SiteFooter.astro';
export function getStaticPaths(){return ['en','zh'].map(lang=>({params:{lang},props:{lang}}))} const lang=((Astro.props??{}).lang??'en')==='zh'?'zh':'en'; const text=v=>typeof v==='string'?v:v?.[lang]??'';
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{lang==='zh'?'新闻':'News'} · 55AA Security Lab</title></head><body><SiteHeader lang={lang} blogHref="news/"/><main><h1>{lang==='zh'?'新闻':'News'}</h1>{news.entries.map(entry=><article><time datetime={entry.date}>{entry.date}</time><p>{text(entry.title)}</p></article>)}</main><SiteFooter lang={lang}/></body></html>
<style>:global(*){box-sizing:border-box}:global(html){overflow-y:scroll}:global(body){min-height:100vh;display:flex;flex-direction:column;margin:0;background:#fff;color:#000;font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(main){flex:1;width:min(960px,calc(100% - 2rem));margin:0 auto;padding:1.5rem 0 2rem}h1{display:none}article{margin:0 0 .75rem}time{color:#777;font-size:.9rem}p{margin:.1rem 0 0}</style>
