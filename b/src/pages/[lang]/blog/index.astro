---
import blog from '../../../data/blog.json'; import SiteHeader from '../../../components/SiteHeader.astro'; import SiteFooter from '../../../components/SiteFooter.astro';
export function getStaticPaths(){return ['en','zh'].map(lang=>({params:{lang},props:{lang}}))} const lang=((Astro.props??{}).lang??'en')==='zh'?'zh':'en';
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{blog.meta.title[lang]} · 55AA Security Lab</title><meta name="description" content={blog.meta.description[lang]}/></head><body><SiteHeader lang={lang} blogHref="blog/"/><main><h1>{blog.meta.title[lang]}</h1>{blog.entries.map((entry,index)=><article><p class="meta"><time datetime={entry.date}>{entry.date}</time> · {entry.meta[lang]}</p><h2><a href={`/${lang}/blog/${entry.date}-${index+1}/`}>{entry.title[lang]}</a></h2><p>{entry.body[lang]}</p></article>)}</main><SiteFooter lang={lang}/></body></html>
<style>:global(*){box-sizing:border-box}:global(html){overflow-y:scroll}:global(body){min-height:100vh;display:flex;flex-direction:column;margin:0;background:#fff;color:#000;font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(main){flex:1;width:min(960px,calc(100% - 2rem));margin:0 auto;padding:1.5rem 0 2rem}h1{display:none;font-size:1.45rem;margin:0 0 1.2rem}h2{font-size:1.05rem;margin:0 0 .25rem}h2 a{color:#06c}.meta{color:#777;font-size:.9rem}article{margin:0 0 1.35rem}p{margin:.25rem 0 .65rem}main>h1+p{margin-top:0}</style>
