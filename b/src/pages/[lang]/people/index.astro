---
import data from '../../../data/people.json'; import SiteHeader from '../../../components/SiteHeader.astro'; import SiteFooter from '../../../components/SiteFooter.astro';
export function getStaticPaths(){return ['en','zh'].map(lang=>({params:{lang},props:{lang}}))} const lang=((Astro.params??{}).lang??(Astro.props??{}).lang??'en')==='zh'?'zh':'en'; const text=v=>typeof v==='string'?v:v?.[lang]??'';
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{lang==='zh'?'成员':'People'} · 55AA Security Lab</title><meta name="description" content={lang==='zh'?'55AA 安全实验室成员。':'People at 55AA Security Lab.'}/></head><body><SiteHeader lang={lang} blogHref="people/"/><main><h1>{lang==='zh'?'成员':'People'}</h1>{data.people.map(p=><article class="person"><img src={p.profileImage} alt={text(p.alt)}/><div><h2>{p.name}</h2><p>{text(p.role)}</p><p>{p.interests[lang].join(' · ')}</p><p>{text(p.motto)}</p></div></article>)}</main><SiteFooter lang={lang}/></body></html>
<style>:global(*){box-sizing:border-box}:global(html){overflow-y:scroll}:global(body){min-height:100vh;display:flex;flex-direction:column;margin:0;background:#fff;color:#000;font:16px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(main){flex:1;width:min(960px,calc(100% - 2rem));margin:0 auto;padding:1.5rem 0 2rem}h1{display:none;font-size:1.45rem;margin:0 0 1.2rem}h2{font-size:1.05rem;margin:0}.person{display:flex;gap:1.25rem;margin-bottom:1.35rem}.person img{width:144px;height:144px;object-fit:cover}.person p{margin:.15rem 0}main>h1+p{margin-top:0}</style>
