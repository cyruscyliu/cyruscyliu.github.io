---
import data from '../../../data/people.json';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SeoHead from '../../../components/SeoHead.astro';
import PersonInfo from '../../../components/PersonInfo.astro';

export function getStaticPaths() {
  return ['en', 'zh'].map((lang) => ({ params: { lang }, props: { lang } }));
}

const runtimePath = Astro.url?.pathname ?? Astro.request?.url ?? '';
const lang = runtimePath.includes('/zh/')
  ? 'zh'
  : ((Astro.props?.lang ?? 'en') === 'zh' ? 'zh' : 'en');
const text = (value) => typeof value === 'string' ? value : value?.[lang] ?? '';
const title = lang === 'zh' ? '成员' : 'People';
const description = lang === 'zh' ? '55AA 安全实验室成员。' : 'People at 55AA Security Lab.';
---

<!doctype html>
<html lang={lang}>
<head>
<SeoHead lang={lang} path="people" title={`${title} · 55AA Security Lab`} description={description}/>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: lang === 'zh' ? '55AA 安全实验室成员' : '55AA Security Lab people',
  itemListElement: data.people.map((person, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Person',
      name: person.name,
      jobTitle: text(person.role),
      image: person.profileImage,
      sameAs: person.links.filter((link) => link.kind !== 'email').map((link) => link.url),
      worksFor: { '@type': 'Organization', name: '55AA Security Lab', url: 'https://www.55aaseclab.com/' }
    }
  }))
})} />
</head>
<body>
<SiteHeader lang={lang} blogHref="people/"/>
<main>
  <h1 class="page-title">{title}</h1>
  <div class="people-grid">
    {data.people.map((person) => (
      <article class="person-card">
        {person.profile ? (
          <a class="person-image-link" href={`/${lang}/people/${person.profile.slug}/`}>
            <img class="person-image" src={person.profileImage} alt={text(person.alt)} width="88" height="88" />
          </a>
        ) : (
          <img class="person-image" src={person.profileImage} alt={text(person.alt)} width="88" height="88" />
        )}
        <div class="person-body">
          <PersonInfo
            person={person}
            lang={lang}
            nameTag="h2"
            nameHref={person.profile ? `/${lang}/people/${person.profile.slug}/` : undefined}
          />
        </div>
      </article>
    ))}
  </div>
</main>
<SiteFooter lang={lang}/>
</body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { overflow-y: scroll; }
  :global(body) {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    margin: 0;
    background: #fff;
    color: #000;
    font: 16px/1.55 system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  :global(main) {
    flex: 1;
    width: min(960px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 2rem;
  }
  .page-title { display: none; }
  .people-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .person-card { display: flex; gap: 1rem; padding: 1rem; background: rgba(255, 255, 255, 0.86); }
  .person-image-link { display: block; flex: 0 0 auto; }
  .person-image { display: block; width: 88px; height: 88px; object-fit: cover; }
  .person-body { min-width: 0; }
  @media (max-width: 600px) {
    .people-grid { grid-template-columns: 1fr; }
  }
</style>
